{
  // For isolated local Worker development. Replace the ID before any remote deployment.
  "name": "madarom-local",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "madarom-local",
    "database_id": "00000000-0000-0000-0000-000000000001"
  }]
}
