{
  // Copy to wrangler.local.jsonc and replace database_id with your D1 database ID.
  // This example is not loaded automatically by Cloudflare Pages Git builds.
  "name": "madarom-local",
  "compatibility_date": "2026-09-23",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "madarom",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "preview_database_id": "DB"
    }
  ]
}
