{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bsda",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shmuelnode-db",
      "database_id": "c9201b34-d2be-4c95-b981-09ae567c072b"
    }
  ],
  "observability": {
    "enabled": true
  }
}
