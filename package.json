{
  "name": "madarom-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:functions": "wrangler pages functions build --outdir=./worker/ --compatibility-date=2026-09-23 --compatibility-flags=nodejs_compat",
    "build": "npm run build:web && node scripts/prepare-worker-build.mjs && npm run build:functions",
    "deploy": "node scripts/deploy.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "admin:create": "node scripts/create-admin.mjs",
    "auth:restore": "node scripts/restore-auth-settings.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "nodemailer": "^10.0.14",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "wrangler": "^4.140.0"
  }
}
